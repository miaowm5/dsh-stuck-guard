{
  "name": "dsh-stuck-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adds a stop-and-report checkpoint to the system prompt after consecutive tool failures.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
