{
  "name": "dsh-stuck-guard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Adds a stop-and-report checkpoint to the system prompt after consecutive tool failures.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "agent",
    "guardrails",
    "prompt"
  ],
  "homepage": "https://github.com/miaowm5/dsh-stuck-guard#readme",
  "bugs": {
    "url": "https://github.com/miaowm5/dsh-stuck-guard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miaowm5/dsh-stuck-guard.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/simulate.mjs && node test/client-simulate.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "locale",
        "remote",
        "remote.settings"
      ]
    }
  }
}
